# ----------------------------------------------------------------------
# PostgreSQL bootstrap configuration
# ----------------------------------------------------------------------
POSTGRES_USER=dwh_owner
POSTGRES_PASSWORD=change_me
POSTGRES_DB=finance_analytics

# ----------------------------------------------------------------------
# PostgreSQL connection parameters
# ----------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DB=finance_analytics
PG_USER=ingestion_user

# ----------------------------------------------------------------------
# Passwords for service roles created during bootstrap
# ----------------------------------------------------------------------
DBT_RUNNER_PASSWORD=strong_dbt_password
INGESTION_USER_PASSWORD=strong_ingestion_password
BI_USER_PASSWORD=strong_bi_password
BI_DEMO_USER_PASSWORD=strong_bi_demo_password
DEV_USER_PASSWORD=strong_dev_password

# ----------------------------------------------------------------------
# S3 storage configuration
# ----------------------------------------------------------------------
S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
S3_REGION=ru-1
S3_BUCKET=your_bucket
S3_PREFIX=your_prefix

# ----------------------------------------------------------------------
# Logical metadata describing the data source
# ----------------------------------------------------------------------
SOURCE_SYSTEM=money_flow_app
SOURCE_OBJECT=money_flow

# ----------------------------------------------------------------------
# CSV parsing configuration
# ----------------------------------------------------------------------
CSV_ENCODING=utf-8
CSV_DELIMITER=,
CSV_QUOTECHAR='"'

# ----------------------------------------------------------------------
# Superset configuration
# ----------------------------------------------------------------------
SUPERSET_SECRET_KEY=put_really_long_random_key_here
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_FIRSTNAME=Name
SUPERSET_ADMIN_LASTNAME=Lastname
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ADMIN_PASSWORD=change_me_now

# ----------------------------------------------------------------------
# Prefect database configuration
# ----------------------------------------------------------------------
PREFECT_DB_USER=prefect
PREFECT_DB_PASSWORD=change_me_prefect
PREFECT_DB_NAME=prefect

# ----------------------------------------------------------------------
# Optional demo environment
# ----------------------------------------------------------------------
DBT_ENABLE_DEMO=False

# ----------------------------------------------------------------------
# Exchange rates ingestion
# ----------------------------------------------------------------------
# FX_SOURCE currently supports: cbr (Bank of Russia)
FX_SOURCE=cbr
FX_CURRENCIES=USD,KGS
FX_REFRESH_INTERVAL_MINUTES=360
FX_INITIAL_LOOKBACK_DAYS=14
FX_RELOAD_LOOKBACK_DAYS=7
FX_HTTP_TIMEOUT_SECONDS=30
